{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(pnpm -C frontend:*)",
      "Bash(pnpm test)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm coverage:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vite preview:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(mkdir -p docs/qa:*)",
      "Bash(agent-browser open:*)",
      "Bash(agent-browser snapshot:*)",
      "Bash(agent-browser click:*)",
      "Bash(agent-browser fill:*)",
      "Bash(agent-browser press:*)",
      "Bash(agent-browser wait:*)",
      "Bash(agent-browser errors:*)",
      "Bash(agent-browser console:*)",
      "Bash(agent-browser set viewport:*)",
      "Bash(agent-browser screenshot:*)",
      "Bash(agent-browser close:*)",
      "Bash(agent-browser get:*)",
      "Bash(agent-browser find:*)",
      "Bash(agent-browser skills get:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm -C frontend add:*)",
      "Bash(pnpm -C frontend remove:*)",
      "Bash(pnpm -C frontend up:*)",
      "Bash(pnpm -C frontend update:*)",
      "Bash(pnpm -C frontend install:*)",
      "Bash(pnpm -C frontend i:*)",
      "Bash(pnpm -C frontend rm:*)",
      "Bash(pnpm -C frontend uninstall:*)",
      "Bash(pnpm -C frontend un:*)",
      "Bash(pnpm -C frontend upgrade:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(cat .env)",
      "Read(./.env)",
      "Bash(agent-browser eval:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git push origin main -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(less .env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
