{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/main.tsx", "src/test/setup.ts", "src/utils/utils.ts", "e2e/**/*.ts", "e2e-stack/**/*.ts", "playwright.stack.config.ts", "scripts/*.mjs"],
  "ignorePatterns": ["dist/**", "coverage/**", ".claude/**", "public/**"],
  "ignoreDependencies": ["react-is"],
  "duplicates": { "mode": "mild", "minLines": 5, "minTokens": 50, "threshold": 0.5 },
  "rules": { "unused-files": "error", "unused-exports": "error", "unused-types": "warn", "unused-dependencies": "error" }
}
