{
  "name": "journal-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "analyze": "fallow dupes && fallow dead-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && node scripts/coverage-band.mjs",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify:fast": "pnpm typecheck:app && pnpm lint",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@sentry/react": "^11.6.0",
    "clsx": "2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.1",
    "fallow": "3.29.0",
    "globals": "^17.12.0",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.28.1"
}
