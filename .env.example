# Copy to .env. Every variable is optional; defaults run the app locally with the fake AI provider.

# AI — set ANTHROPIC_API_KEY to use Claude; leave empty for the deterministic fake provider.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=   (required when the key is user/organization-scoped)
# AI_PROVIDER=anthropic|fake   (auto: anthropic when a key is set)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=30
# Live hints while writing (POST /api/v1/check): fast model, effort low, one attempt (no SDK retries), nothing stored or traced.
AI_LIVE_MODEL=claude-haiku-5-5
AI_LIVE_TIMEOUT_SECONDS=8
# Tracing - Langfuse stays off unless all three are set. Traces carry metadata only
# (model, prompt version, latency, tokens, failure code), never entry text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

DATABASE_URL=postgresql+asyncpg://journal:journal@localhost:5432/journal
TEST_DATABASE_URL=postgresql+asyncpg://journal:journal@localhost:5432/journal_test

LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:5173"]

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
RELEASE=dev

VITE_SENTRY_DSN=
VITE_RELEASE=dev
# Frontend dev data: the in-memory MSW API is on by default; set off to use `make dev-backend` via the Vite proxy.
VITE_API_MOCKS=on
# VITE_API_BASE=   (absolute API base; defaults to <page origin>/api/v1/)
